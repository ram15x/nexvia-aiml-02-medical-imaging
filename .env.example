# Copy to .env in the project root. Keep .env private and never commit it.
# These model files are included under the project's artifacts/ directory.
NEXVIA_CHECKPOINT=artifacts/best_densenet121.pt
NEXVIA_SEGMENTATION_CHECKPOINT=artifacts/best_spleen_unet_candidate_20261103.pt
NEXVIA_SEGMENTATION_THRESHOLD=0.50
NEXVIA_SEGMENTATION_TTA=false

# Local JSONL state; paths are resolved relative to the project root.
NEXVIA_AUDIT_PATH=demo/review_events.jsonl
NEXVIA_ORTHANC_RESULTS_PATH=demo/orthanc_predictions.jsonl
NEXVIA_ORTHANC_SYNC_STATE_PATH=demo/orthanc_sync_state.json
NEXVIA_ORTHANC_SEGMENTATION_RESULTS_PATH=demo/orthanc_segmentations.jsonl
NEXVIA_ORTHANC_SEGMENTATION_MASK_DIR=demo/orthanc_masks

# Host ports and browser-to-API URL.
NEXVIA_API_PORT=18080
NEXVIA_WEB_PORT=15180
NEXVIA_CORS_ORIGINS=http://localhost:15180,http://127.0.0.1:15180
VITE_API_URL=http://localhost:18080

# Optional Orthanc profile. Replace the password before enabling that profile.
ORTHANC_HTTP_PORT=18042
ORTHANC_DICOM_PORT=14242
ORTHANC_URL=http://orthanc:8042
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=replace-with-a-strong-local-password
ORTHANC__NAME=Nexvia AIML-02 local demo
ORTHANC__REMOTE_ACCESS_ALLOWED=true
ORTHANC__AUTHENTICATION_ENABLED=true
